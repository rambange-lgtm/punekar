
pipeline {
    agent any
    tools {
        maven 'maven3.9.14'
        jdk 'java17'
    }
    stages {
        stage ('checkout') {
            steps {
                git branch: 'project-1', url: 'https://github.com/ajip4241/simple-java-app.git'
            }
        }
        stage ('Build') {
            steps {
                sh 'mvn clean package'
            }
        }
        stage ('post-build') {
            steps {
                echo "Build completed successfully"
            }
        }
    }
}

